{
  "name": "dsh-meter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A usage ring under the DSH composer showing the current model plan's headroom, with per-window reset dates and one-click console sign-in.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiufeigo/dsh-meter.git"
  },
  "homepage": "https://github.com/xiufeigo/dsh-meter#readme",
  "bugs": {
    "url": "https://github.com/xiufeigo/dsh-meter/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "quota",
    "usage",
    "minimax",
    "kimi",
    "opencode",
    "stepfun",
    "xiaomi-mimo"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node test/render-smoke.mjs",
    "pack:release": "npm pack"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
